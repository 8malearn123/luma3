# ─────────────────────────────────────────────────────────────────────────────
# LUMA environment configuration. Copy to `.env` and fill in values.
# NEVER commit real secrets. Every variable below is read server-side only;
# nothing here is exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | review | production   (REQUIRED)
# review = a private deployed review build (secure cookies, mandatory admin MFA,
# noindex) that still uses the payment sandbox and on-screen codes.
APP_ENV=development
# Public base URL used in links, emails and webhook callbacks (REQUIRED)
APP_URL=http://localhost:3000

# Runtime connection — must be the NON-owner application role so that
# row-level security applies. (REQUIRED)
DATABASE_URL=postgres://luma_app:CHANGE_ME@localhost:5432/luma_dev
# Owner connection used only by migrations/seed scripts. (REQUIRED for scripts)
DATABASE_OWNER_URL=postgres://luma_owner:CHANGE_ME@localhost:5432/luma_dev
# Name of the runtime role that migrations grant privileges to. (default luma_app)
DB_APP_ROLE=luma_app

# 32+ random bytes, base64. Used to HMAC session/preview/invite tokens. (REQUIRED)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ── Demo / development switches (forced OFF when APP_ENV=production) ─────────
# Shows the private demo role switcher on the login page (seeded demo users only).
DEMO_MODE=false
# Shows one-time codes on screen and in the dev outbox instead of sending them.
# This is a clearly-labelled DEVELOPMENT OTP flow; it never runs in production.
DEV_OTP_ECHO=false
# Require LUMA platform staff to enrol in MFA before using the admin area.
# Always enforced when APP_ENV=production regardless of this value.
PLATFORM_MFA_REQUIRED=true
# Reverse proxies in front of the app that append to X-Forwarded-For. Rate limits key on the
# address appended by the outermost trusted proxy; client-supplied entries are ignored.
TRUSTED_PROXY_HOPS=1

# ── Object storage ───────────────────────────────────────────────────────────
# local = filesystem (development). db = files stored in PostgreSQL (use on
# serverless hosts such as Vercel, which have no persistent disk).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# ── Messaging providers (OPTIONAL) ───────────────────────────────────────────
# none = deliveries are recorded as "simulated" and never leave the server.
EMAIL_PROVIDER=none
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none

# ── AI provider (OPTIONAL) ───────────────────────────────────────────────────
# When OPENAI_API_KEY or OPENAI_MODEL is empty, AI features report
# "disconnected" honestly and the manual flows keep working.
OPENAI_API_KEY=
# Use an exact model id available to your account; no default is assumed.
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional documented price per 1M tokens (USD) for cost estimates; leave empty if unknown.
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=
AI_REQUEST_TIMEOUT_MS=45000

# ── Payments (sandbox only in this delivery) ─────────────────────────────────
# Secret used to sign webhooks from the built-in LUMA Sandbox provider.
PAYMENT_SANDBOX_WEBHOOK_SECRET=

# ── Hosting ──────────────────────────────────────────────────────────────────
# Optional: overrides DATABASE_URL (for hosts that inject an owner connection string,
# e.g. Vercel's Neon integration). Must be the NON-owner application role.
LUMA_DATABASE_URL=
# Max PostgreSQL connections per server instance. Use 3 on serverless (Vercel).
DB_POOL_MAX=10
# Enables GET /api/v1/internal/cron (one background-worker pass) for hosts that
# cannot run `pnpm worker`. 24+ random characters; unset = endpoint disabled.
CRON_SECRET=
