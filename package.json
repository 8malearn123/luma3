{
  "name": "luma",
  "version": "0.1.0",
  "private": true,
  "description": "LUMA — SaaS platform for salons, beauty businesses and independent beauty experts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-dev": "tsx scripts/reset-dev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:create-app-role": "tsx scripts/create-app-role.ts",
    "vercel-build": "tsx scripts/vercel-setup.ts && next build",
    "test:demo": "playwright test -c playwright.demo.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@electric-sql/pglite": "0.5.8",
    "@tanstack/react-query": "5.90.5",
    "kysely": "0.29.5",
    "lucide-react": "1.40.0",
    "luxon": "3.7.2",
    "next": "16.3.8",
    "pg": "8.22.0",
    "playwright-core": "1.56.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sanitize-html": "2.17.0",
    "server-only": "0.0.1",
    "sharp": "0.34.5",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.2.4",
    "@types/luxon": "3.7.1",
    "@types/node": "22.19.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "kysely-codegen": "0.20.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
